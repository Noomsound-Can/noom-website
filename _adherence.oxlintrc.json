{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "i18n-extra.js",
              "i18n-extra2.js",
              "i18n-extra3.js",
              "i18n-extra4.js",
              "i18n.js",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cormorant Garamond|IBM Plex Mono|Inter))/i]",
        "message": "Font not provided by the design system. Available: Cormorant Garamond, IBM Plex Mono, Inter."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "About": {
        "replaces": []
      },
      "Audio": {
        "replaces": []
      },
      "Calendar": {
        "replaces": []
      },
      "Footer": {
        "replaces": []
      },
      "Hero": {
        "replaces": []
      },
      "Intro": {
        "replaces": []
      },
      "Nav": {
        "replaces": []
      },
      "Sessions": {
        "replaces": []
      }
    },
    "tokens": [
      "--accent",
      "--bg",
      "--bg-alt",
      "--clay",
      "--container",
      "--cream",
      "--cream-deep",
      "--cream-soft",
      "--dur-fast",
      "--dur-med",
      "--dur-slow",
      "--ease-slow",
      "--fg",
      "--fg-mute",
      "--fg-soft",
      "--fs-body",
      "--fs-display",
      "--fs-h1",
      "--fs-h2",
      "--fs-h3",
      "--fs-lead",
      "--fs-meta",
      "--fs-small",
      "--gutter",
      "--ink",
      "--ink-faint",
      "--ink-mute",
      "--ink-soft",
      "--measure",
      "--mono",
      "--paper",
      "--r-0",
